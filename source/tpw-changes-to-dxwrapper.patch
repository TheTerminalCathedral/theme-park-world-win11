+bool m_IDirectDrawSurfaceX::TPWSmallReadback(LPDIRECT3DSURFACE9 pSrc, const RECT& SrcRect, const RECT& DestRect)
+{
+	D3DSURFACE_DESC SrcDesc = {};
+	if (!pSrc || FAILED(pSrc->GetDesc(&SrcDesc)) || SrcDesc.MultiSampleType != D3DMULTISAMPLE_NONE ||
+		(SrcDesc.Format != D3DFMT_X8R8G8B8 && SrcDesc.Format != D3DFMT_A8R8G8B8))
+	{
+		return false;
+	}
+
+	// (Re)create the small surfaces for the current device and format
+	if (TPWReadback.Device != *d3d9Device || TPWReadback.Format != SrcDesc.Format || !TPWReadback.RenderTarget || !TPWReadback.SystemMemory)
+	{
+		TPWReleaseReadbackSurfaces();
+		if (FAILED((*d3d9Device)->CreateRenderTarget(TPWReadbackSize, TPWReadbackSize, SrcDesc.Format, D3DMULTISAMPLE_NONE, 0, FALSE, &TPWReadback.RenderTarget, nullptr)) ||
+			FAILED((*d3d9Device)->CreateOffscreenPlainSurface(TPWReadbackSize, TPWReadbackSize, SrcDesc.Format, D3DPOOL_SYSTEMMEM, &TPWReadback.SystemMemory, nullptr)))
+		{
+			LOG_LIMIT(10, __FUNCTION__ << " TPW: could not create small readback surfaces");
+			TPWReleaseReadbackSurfaces();
+			return false;
+		}
+		TPWReadback.Device = *d3d9Device;
+		TPWReadback.Format = SrcDesc.Format;
+	}
+
+	const LONG Width = DestRect.right - DestRect.left;
+	const LONG Height = DestRect.bottom - DestRect.top;
+	RECT SmallRect = { 0, 0, Width, Height };
+
+	// Copy only the rect on the GPU, then read back the small surface
+	if (FAILED((*d3d9Device)->StretchRect(pSrc, &SrcRect, TPWReadback.RenderTarget, &SmallRect, D3DTEXF_NONE)) ||
+		FAILED((*d3d9Device)->GetRenderTargetData(TPWReadback.RenderTarget, TPWReadback.SystemMemory)))
+	{
+		LOG_LIMIT(10, __FUNCTION__ << " TPW: small readback failed");
+		return false;
+	}
+
+	D3DLOCKED_RECT SrcLock = {};
+	if (FAILED(TPWReadback.SystemMemory->LockRect(&SrcLock, &SmallRect, D3DLOCK_READONLY)))
+	{
+		return false;
+	}
+
+	bool Copied = false;
+	RECT Dest = DestRect;
+	DDSURFACEDESC2 Desc = {};
+	Desc.dwSize = sizeof(DDSURFACEDESC2);
+	if (SUCCEEDED(Lock2(&Dest, &Desc, DDLOCK_WAIT | DDLOCK_WRITEONLY, nullptr, 0, 7)))
+	{
+		if (Desc.lpSurface && Desc.ddpfPixelFormat.dwRGBBitCount == 32)
+		{
+			for (LONG y = 0; y < Height; y++)
+			{
+				memcpy((BYTE*)Desc.lpSurface + y * Desc.lPitch, (const BYTE*)SrcLock.pBits + y * SrcLock.Pitch, Width * 4);
+			}
+			Copied = true;
+		}
+		Unlock(&Dest, 0);
+	}
+	TPWReadback.SystemMemory->UnlockRect();
+
+	if (Copied && TPWReadback.Count++ < 5)
+	{
+		Logging::Log() << __FUNCTION__ << " TPW: small render target readback " << Width << "x" << Height << " from " << SrcRect.left << "," << SrcRect.top;
+	}
+	return Copied;
+}
