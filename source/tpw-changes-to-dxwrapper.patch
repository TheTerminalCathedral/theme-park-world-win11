+// TPW: keep the pillarboxed window fitted to its monitor when the desktop resolution changes while the game runs
+// (for example when Parsec switches the resolution). The back buffer keeps its size and is scaled to the window.
+static void TPWCheckPillarboxMonitor(HWND hWnd)
+{
+	static DWORD LastCheck = 0;
+	static RECT LastMonitorRect = {};
+
+	// The windowed pillarbox stays where the user puts it
+	if (!PillarboxActive || Config.DdrawPillarboxWindowed || !IsWindow(hWnd) || !DisplayMode.Width || !DisplayMode.Height ||
+		GetWindowThreadProcessId(hWnd, nullptr) != GetCurrentThreadId())	// Only move the window from its own thread
+	{
+		return;
+	}
+
+	const DWORD Now = GetTickCount();
+	if (Now - LastCheck < 500)
+	{
+		return;
+	}
+	LastCheck = Now;
+
+	MONITORINFO mi = {};
+	mi.cbSize = sizeof(MONITORINFO);
+	if (!GetMonitorInfo(MonitorFromWindow(hWnd, MONITOR_DEFAULTTONEAREST), &mi) || EqualRect(&mi.rcMonitor, &LastMonitorRect))
+	{
+		return;
+	}
+	LastMonitorRect = mi.rcMonitor;
+
+	// Largest rect with the game's aspect ratio, centered on the monitor
+	const LONG MonitorWidth = mi.rcMonitor.right - mi.rcMonitor.left;
+	const LONG MonitorHeight = mi.rcMonitor.bottom - mi.rcMonitor.top;
+	LONG Width = MonitorWidth;
+	LONG Height = MonitorHeight;
+	if ((LONGLONG)DisplayMode.Width * MonitorHeight < (LONGLONG)DisplayMode.Height * MonitorWidth)
+	{
+		Width = (LONG)((LONGLONG)MonitorHeight * DisplayMode.Width / DisplayMode.Height);
+	}
+	else
+	{
+		Height = (LONG)((LONGLONG)MonitorWidth * DisplayMode.Height / DisplayMode.Width);
+	}
+	const LONG Left = mi.rcMonitor.left + (MonitorWidth - Width) / 2;
+	const LONG Top = mi.rcMonitor.top + (MonitorHeight - Height) / 2;
+
+	RECT WindowRect = {};
+	GetWindowRect(hWnd, &WindowRect);
+	if (WindowRect.left == Left && WindowRect.top == Top && WindowRect.right - WindowRect.left == Width && WindowRect.bottom - WindowRect.top == Height)
+	{
+		return;
+	}
+
+	SetWindowPos(hWnd, HWND_TOP, Left, Top, Width, Height, SWP_NOACTIVATE);
+	ShowPillarboxBackdrop(hWnd, mi.rcMonitor);
+	LOG_LIMIT(50, __FUNCTION__ << " Pillarbox: monitor is now " << MonitorWidth << "x" << MonitorHeight << ", window moved to " <<
+		Left << "," << Top << " " << Width << "x" << Height);
+}
