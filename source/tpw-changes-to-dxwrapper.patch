+
+// TPW: keep the game's aspect ratio while the user resizes the framed pillarbox window (called for WM_SIZING)
+bool TPWPillarboxSizing(HWND hWnd, WPARAM Edge, RECT* pRect)
+{
+	if (!PillarboxActive || !IsPillarboxFramed() || !pRect || !DisplayMode.Width || !DisplayMode.Height)
+	{
+		return false;
+	}
+
+	RECT Frame = {};
+	AdjustWindowRectEx(&Frame, GetWindowLong(hWnd, GWL_STYLE), GetMenu(hWnd) != NULL, GetWindowLong(hWnd, GWL_EXSTYLE));
+	const LONG FrameWidth = Frame.right - Frame.left;
+	const LONG FrameHeight = Frame.bottom - Frame.top;
+
+	// Dragging the top or bottom edge sets the height, everything else sets the width
+	LONG ClientWidth = (pRect->right - pRect->left) - FrameWidth;
+	LONG ClientHeight = (pRect->bottom - pRect->top) - FrameHeight;
+	if (Edge == WMSZ_TOP || Edge == WMSZ_BOTTOM)
+	{
+		ClientWidth = (LONG)((LONGLONG)ClientHeight * DisplayMode.Width / DisplayMode.Height);
+	}
+	ClientWidth = (std::max)(ClientWidth, PillarboxMinClientWidth);
+	ClientHeight = (LONG)((LONGLONG)ClientWidth * DisplayMode.Height / DisplayMode.Width);
+
+	const LONG WindowWidth = ClientWidth + FrameWidth;
+	const LONG WindowHeight = ClientHeight + FrameHeight;
+	if (Edge == WMSZ_LEFT || Edge == WMSZ_TOPLEFT || Edge == WMSZ_BOTTOMLEFT)
+	{
+		pRect->left = pRect->right - WindowWidth;
+	}
+	else
+	{
+		pRect->right = pRect->left + WindowWidth;
+	}
+	if (Edge == WMSZ_TOP || Edge == WMSZ_TOPLEFT || Edge == WMSZ_TOPRIGHT)
+	{
+		pRect->top = pRect->bottom - WindowHeight;
+	}
+	else
+	{
+		pRect->bottom = pRect->top + WindowHeight;
+	}
+	return true;
+}
