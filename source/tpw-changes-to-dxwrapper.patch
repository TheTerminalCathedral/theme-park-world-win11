+// TPW: pillarbox state for the window message handler
+bool TPWIsPillarboxActive()
+{
+	return PillarboxActive;
+}
+
+bool TPWIsPillarboxFramed()
+{
+	return PillarboxActive && IsPillarboxFramed();
