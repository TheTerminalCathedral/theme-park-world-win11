 #pragma once
 
+// TPW diagnostics and UI state block cache support shared with surfaces
+enum TPWSURFACETIMINGTYPE { TPW_TIME_LOCK, TPW_TIME_UNLOCK, TPW_TIME_BLT, TPW_TIME_BLTFAST, TPW_TIME_FLIP, TPW_TIME_COUNT };
+struct TPWSURFACETIMING {
+	volatile LONGLONG Ticks[TPW_TIME_COUNT] = {};
+	volatile LONG Count[TPW_TIME_COUNT] = {};
+	volatile LONG OtherThreadCount[TPW_TIME_COUNT] = {};
+};
+extern TPWSURFACETIMING TPWSurfaceTiming;
+extern volatile LONG TPWTextureGeneration;	// Changes whenever a surface releases its d3d9 textures
+extern DWORD TPWRenderThreadId;
+void TPWReleaseReadbackSurfaces();	// Small render target readback surfaces, released before the d3d9 device releases or resets its resources
+
+// Times one surface call, nested calls on the same thread are only counted once
+class TPWScopedSurfaceTimer {
+	TPWSURFACETIMINGTYPE Type;
+	LONGLONG Start = 0;
+	bool IsOuter = false;
+	static thread_local LONG Depth;
+public:
+	explicit TPWScopedSurfaceTimer(TPWSURFACETIMINGTYPE t) : Type(t)
+	{
+		IsOuter = (Depth++ == 0);
+		if (IsOuter)
+		{
+			LARGE_INTEGER Now;
+			QueryPerformanceCounter(&Now);
+			Start = Now.QuadPart;
+		}
+	}
+	~TPWScopedSurfaceTimer()
+	{
+		Depth--;
+		if (IsOuter)
+		{
+			LARGE_INTEGER Now;
+			QueryPerformanceCounter(&Now);
+			InterlockedAdd64(&TPWSurfaceTiming.Ticks[Type], Now.QuadPart - Start);
+			InterlockedIncrement(&TPWSurfaceTiming.Count[Type]);
+			if (TPWRenderThreadId && GetCurrentThreadId() != TPWRenderThreadId)
+			{
+				InterlockedIncrement(&TPWSurfaceTiming.OtherThreadCount[Type]);
+			}
+		}
+	}
+};
