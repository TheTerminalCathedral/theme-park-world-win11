+// TPW stall trace: when no scene has begun for 2 s, count the wrapper functions each thread calls and log the top list
+volatile bool Logging::StallTrace::Enabled = false;
+namespace {
+	struct {
+		SRWLOCK Lock = SRWLOCK_INIT;
+		volatile DWORD LastSceneTick = 0;
+		DWORD WindowStartTick = 0;
+		DWORD WindowSceneTick = 0;
+		std::map<std::pair<DWORD, const char*>, DWORD> Counts;
+		DWORD Dumps = 0;
+	} TPWStall;
+}
+
+void Logging::StallTrace::Record(const char* Name)
+{
+	const DWORD LastScene = TPWStall.LastSceneTick;
+	if (!LastScene || TPWStall.Dumps >= 3)
+	{
+		return;
+	}
+	const DWORD Now = GetTickCount();
+	if (Now - LastScene < 2000)
+	{
+		return;
+	}
+
+	AcquireSRWLockExclusive(&TPWStall.Lock);
+	if (!TPWStall.WindowStartTick || TPWStall.WindowSceneTick != LastScene)
+	{
+		TPWStall.WindowStartTick = Now;
+		TPWStall.WindowSceneTick = LastScene;
+		TPWStall.Counts.clear();
+	}
+	TPWStall.Counts[{ GetCurrentThreadId(), Name }]++;
+
+	// Log the most called functions after collecting for 4 seconds
+	if (Now - TPWStall.WindowStartTick >= 4000)
+	{
+		std::vector<std::pair<std::pair<DWORD, const char*>, DWORD>> Sorted(TPWStall.Counts.begin(), TPWStall.Counts.end());
+		std::sort(Sorted.begin(), Sorted.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+		Logging::Log() << __FUNCTION__ << " TPW stall trace " << (TPWStall.Dumps + 1) << ": no scene for " << (Now - LastScene) <<
+			" ms, render thread " << TPWRenderThreadId << ", calls in the last " << (Now - TPWStall.WindowStartTick) << " ms:";
+		for (size_t i = 0; i < Sorted.size() && i < 30; i++)
+		{
+			Logging::Log() << __FUNCTION__ << "   thread " << Sorted[i].first.first << " " << Sorted[i].second << "x " <<
+				(Sorted[i].first.second ? Sorted[i].first.second : "?");
+		}
+		TPWStall.Dumps++;
+		TPWStall.WindowStartTick = 0;
+	}
+	ReleaseSRWLockExclusive(&TPWStall.Lock);
+}
