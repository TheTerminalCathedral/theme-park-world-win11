+void m_IDirect3DDeviceX::CaptureUIState(UISTATESNAPSHOT& State, DWORD VertexTypeDesc, DWORD Flags) const
+{
+	std::copy(std::begin(DeviceStates.RenderState), std::end(DeviceStates.RenderState), std::begin(State.RenderState));
+	std::copy(std::begin(DeviceStates.LightState), std::end(DeviceStates.LightState), std::begin(State.LightState));
+	for (UINT x = 0; x < D3DHAL_TSS_MAXSTAGES; x++)
+	{
+		std::copy(std::begin(DeviceStates.TextureStageState[x]), std::end(DeviceStates.TextureStageState[x]), std::begin(State.TextureStageState[x]));
+		std::copy(std::begin(DeviceStates.SamplerState[x]), std::end(DeviceStates.SamplerState[x]), std::begin(State.SamplerState[x]));
+		State.Texture[x] = CurrentTextureSurfaceX[x];
+		State.TextureColorKey[x] = CurrentTextureSurfaceX[x] && CurrentTextureSurfaceX[x]->IsColorKeyTexture();
+	}
+	State.View = DeviceStates.Viewport.View;
+	State.alphaOpSet = DeviceStates.alphaOpSet;
+	State.VertexTypeDesc = VertexTypeDesc;
+	State.Flags = Flags;
+}
+
+bool m_IDirect3DDeviceX::IsSameUIState(const UISTATESNAPSHOT& a, const UISTATESNAPSHOT& b)
+{
+	auto SameStates = [](const STATESTRUCT* x, const STATESTRUCT* y, size_t Count)
+	{
+		for (size_t i = 0; i < Count; i++)
+		{
+			if (x[i].Set != y[i].Set || x[i].State != y[i].State)
+			{
+				return false;
+			}
+		}
+		return true;
+	};
+
+	if (a.VertexTypeDesc != b.VertexTypeDesc || a.Flags != b.Flags || a.alphaOpSet != b.alphaOpSet ||
+		memcmp(&a.View, &b.View, sizeof(D3DVIEWPORT9)) != 0 ||
+		memcmp(a.LightState, b.LightState, sizeof(a.LightState)) != 0 ||
+		memcmp(a.Texture, b.Texture, sizeof(a.Texture)) != 0 ||
+		memcmp(a.TextureColorKey, b.TextureColorKey, sizeof(a.TextureColorKey)) != 0 ||
+		!SameStates(a.RenderState, b.RenderState, D3D_MAXRENDERSTATES))
+	{
+		return false;
+	}
+
+	for (UINT x = 0; x < D3DHAL_TSS_MAXSTAGES; x++)
+	{
+		if (!SameStates(a.TextureStageState[x], b.TextureStageState[x], MaxTextureStageStates) ||
+			!SameStates(a.SamplerState[x], b.SamplerState[x], D3DHAL_TEXTURESTATEBUF_SIZE))
+		{
+			return false;
+		}
+	}
+
+	return true;
+}
+
+ULONGLONG m_IDirect3DDeviceX::HashUIState(const UISTATESNAPSHOT& State)
+{
+	// FNV-1a over the fields compared by IsSameUIState (not over raw struct bytes, which include padding)
+	ULONGLONG Hash = 14695981039346656037ULL;
+	auto Add = [&Hash](ULONGLONG Value)
+	{
+		Hash ^= Value;
+		Hash *= 1099511628211ULL;
+	};
+	auto AddStates = [&Add](const STATESTRUCT* States, size_t Count)
+	{
+		for (size_t i = 0; i < Count; i++)
+		{
+			if (States[i].Set)
+			{
+				Add(((ULONGLONG)i << 32) | States[i].State);
+			}
+		}
+		Add(0xFFFFFFFFULL);
+	};
+
+	AddStates(State.RenderState, D3D_MAXRENDERSTATES);
+	for (UINT x = 0; x < D3DHAL_TSS_MAXSTAGES; x++)
+	{
+		AddStates(State.TextureStageState[x], MaxTextureStageStates);
+		AddStates(State.SamplerState[x], D3DHAL_TEXTURESTATEBUF_SIZE);
+		Add((ULONGLONG)(ULONG_PTR)State.Texture[x]);
+		Add(State.TextureColorKey[x]);
+	}
+	for (DWORD Light : State.LightState)
+	{
+		Add(Light);
+	}
+	Add(State.View.X); Add(State.View.Y); Add(State.View.Width); Add(State.View.Height);
+	Add(*(const DWORD*)&State.View.MinZ); Add(*(const DWORD*)&State.View.MaxZ);
+	Add(State.alphaOpSet);
+	Add(State.VertexTypeDesc);
+	Add(State.Flags);
+	return Hash;
+}
+
+m_IDirect3DDeviceX* m_IDirect3DDeviceX::UIStateBlockCacheOwner = nullptr;
+
+IDirect3DStateBlock9* m_IDirect3DDeviceX::CreateLeanUIStateBlock()
+{
+	// Applying a D3DSBT_ALL state block sets every device state, including all shader constants, transforms and
+	// all 8 texture stages, which RTX Remix has to process for every UI state change. Record only the
+	// fixed-function states UI drawing uses, with the values the device has right now.
+	static const D3DRENDERSTATETYPE RenderStates[] = {
+		D3DRS_ZENABLE, D3DRS_FILLMODE, D3DRS_SHADEMODE, D3DRS_ZWRITEENABLE, D3DRS_ALPHATESTENABLE, D3DRS_LASTPIXEL,
+		D3DRS_SRCBLEND, D3DRS_DESTBLEND, D3DRS_CULLMODE, D3DRS_ZFUNC, D3DRS_ALPHAREF, D3DRS_ALPHAFUNC, D3DRS_DITHERENABLE,
+		D3DRS_ALPHABLENDENABLE, D3DRS_FOGENABLE, D3DRS_SPECULARENABLE, D3DRS_FOGCOLOR, D3DRS_FOGTABLEMODE, D3DRS_FOGSTART,
+		D3DRS_FOGEND, D3DRS_FOGDENSITY, D3DRS_RANGEFOGENABLE, D3DRS_STENCILENABLE, D3DRS_STENCILFAIL, D3DRS_STENCILZFAIL,
+		D3DRS_STENCILPASS, D3DRS_STENCILFUNC, D3DRS_STENCILREF, D3DRS_STENCILMASK, D3DRS_STENCILWRITEMASK, D3DRS_TEXTUREFACTOR,
+		D3DRS_WRAP0, D3DRS_WRAP1, D3DRS_CLIPPING, D3DRS_LIGHTING, D3DRS_AMBIENT, D3DRS_FOGVERTEXMODE, D3DRS_COLORVERTEX,
+		D3DRS_LOCALVIEWER, D3DRS_NORMALIZENORMALS, D3DRS_DIFFUSEMATERIALSOURCE, D3DRS_SPECULARMATERIALSOURCE,
+		D3DRS_AMBIENTMATERIALSOURCE, D3DRS_EMISSIVEMATERIALSOURCE, D3DRS_VERTEXBLEND, D3DRS_CLIPPLANEENABLE,
+		D3DRS_COLORWRITEENABLE, D3DRS_BLENDOP, D3DRS_SCISSORTESTENABLE, D3DRS_SLOPESCALEDEPTHBIAS, D3DRS_DEPTHBIAS,
+		D3DRS_SEPARATEALPHABLENDENABLE, D3DRS_SRCBLENDALPHA, D3DRS_DESTBLENDALPHA, D3DRS_BLENDOPALPHA, D3DRS_SRGBWRITEENABLE };
+	static const D3DTEXTURESTAGESTATETYPE StageStates[] = {
+		D3DTSS_COLOROP, D3DTSS_COLORARG1, D3DTSS_COLORARG2, D3DTSS_ALPHAOP, D3DTSS_ALPHAARG1, D3DTSS_ALPHAARG2,
+		D3DTSS_TEXCOORDINDEX, D3DTSS_TEXTURETRANSFORMFLAGS, D3DTSS_COLORARG0, D3DTSS_ALPHAARG0, D3DTSS_RESULTARG, D3DTSS_CONSTANT };
+	static const D3DSAMPLERSTATETYPE SamplerStates[] = {
+		D3DSAMP_ADDRESSU, D3DSAMP_ADDRESSV, D3DSAMP_ADDRESSW, D3DSAMP_BORDERCOLOR, D3DSAMP_MAGFILTER, D3DSAMP_MINFILTER,
+		D3DSAMP_MIPFILTER, D3DSAMP_MIPMAPLODBIAS, D3DSAMP_MAXMIPLEVEL, D3DSAMP_MAXANISOTROPY, D3DSAMP_SRGBTEXTURE };
+	static const D3DTRANSFORMSTATETYPE Transforms[] = { D3DTS_WORLD, D3DTS_VIEW, D3DTS_PROJECTION, D3DTS_TEXTURE0, D3DTS_TEXTURE1 };
+
+	LPDIRECT3DDEVICE9 pDevice = *d3d9Device;
+
+	// Read the current values first, Get calls are not allowed to see recorded values
+	DWORD RenderValues[_countof(RenderStates)] = {};
+	for (UINT i = 0; i < _countof(RenderStates); i++)
+	{
+		pDevice->GetRenderState(RenderStates[i], &RenderValues[i]);
+	}
+	IDirect3DBaseTexture9* pTextures[D3DHAL_TSS_MAXSTAGES] = {};
+	DWORD StageValues[D3DHAL_TSS_MAXSTAGES][_countof(StageStates)] = {};
+	DWORD SamplerValues[D3DHAL_TSS_MAXSTAGES][_countof(SamplerStates)] = {};
+	bool StageActive[D3DHAL_TSS_MAXSTAGES] = {};
+	bool PreviousStageActive = true;
+	for (UINT x = 0; x < D3DHAL_TSS_MAXSTAGES; x++)
+	{
+		pDevice->GetTexture(x, &pTextures[x]);
+		for (UINT i = 0; i < _countof(StageStates); i++)
+		{
+			pDevice->GetTextureStageState(x, StageStates[i], &StageValues[x][i]);
+		}
+		// Stages after the first disabled stage are not used by fixed-function blending
+		StageActive[x] = PreviousStageActive && StageValues[x][0] != D3DTOP_DISABLE;
+		PreviousStageActive = StageActive[x];
+		if (StageActive[x])
+		{
+			for (UINT i = 0; i < _countof(SamplerStates); i++)
+			{
+				pDevice->GetSamplerState(x, SamplerStates[i], &SamplerValues[x][i]);
+			}
+		}
+	}
+	D3DMATRIX Matrices[_countof(Transforms)] = {};
+	for (UINT i = 0; i < _countof(Transforms); i++)
+	{
+		pDevice->GetTransform(Transforms[i], &Matrices[i]);
+	}
+	DWORD FVF = 0;
+	pDevice->GetFVF(&FVF);
+	D3DVIEWPORT9 Viewport = {};
+	pDevice->GetViewport(&Viewport);
+	D3DMATERIAL9 Material = {};
+	pDevice->GetMaterial(&Material);
+	IDirect3DVertexShader9* pVertexShader = nullptr;
+	pDevice->GetVertexShader(&pVertexShader);
+	IDirect3DPixelShader9* pPixelShader = nullptr;
+	pDevice->GetPixelShader(&pPixelShader);
+
+	// Record them
+	IDirect3DStateBlock9* pStateBlock = nullptr;
+	if (SUCCEEDED(pDevice->BeginStateBlock()))
+	{
+		for (UINT i = 0; i < _countof(RenderStates); i++)
+		{
+			pDevice->SetRenderState(RenderStates[i], RenderValues[i]);
+		}
+		for (UINT x = 0; x < D3DHAL_TSS_MAXSTAGES; x++)
+		{
+			// The first inactive stage still needs its disable ops, so blending stops there
+			if (StageActive[x] || x == 0 || StageActive[x - 1])
+			{
+				pDevice->SetTexture(x, pTextures[x]);
+				for (UINT i = 0; i < _countof(StageStates); i++)
+				{
+					pDevice->SetTextureStageState(x, StageStates[i], StageValues[x][i]);
+				}
+			}
+			if (StageActive[x])
+			{
+				for (UINT i = 0; i < _countof(SamplerStates); i++)
+				{
+					pDevice->SetSamplerState(x, SamplerStates[i], SamplerValues[x][i]);
+				}
+			}
+		}
+		for (UINT i = 0; i < _countof(Transforms); i++)
+		{
+			pDevice->SetTransform(Transforms[i], &Matrices[i]);
+		}
+		pDevice->SetFVF(FVF);
+		pDevice->SetViewport(&Viewport);
+		pDevice->SetMaterial(&Material);
+		pDevice->SetVertexShader(pVertexShader);
+		pDevice->SetPixelShader(pPixelShader);
+
+		if (FAILED(pDevice->EndStateBlock(&pStateBlock)))
+		{
+			pStateBlock = nullptr;
+		}
+	}
+
+	for (IDirect3DBaseTexture9* pTexture : pTextures)
+	{
+		if (pTexture)
+		{
+			pTexture->Release();
+		}
+	}
+	if (pVertexShader)
+	{
+		pVertexShader->Release();
+	}
+	if (pPixelShader)
+	{
+		pPixelShader->Release();
+	}
+
+	if (pStateBlock)
+	{
+		ToWorld.LeanStateBlocks++;
+	}
+	else
+	{
+		ToWorld.LeanStateBlockFailures++;
+		LOG_LIMIT(10, __FUNCTION__ << " Warning: could not record lean UI state block, using D3DSBT_ALL");
+	}
+	return pStateBlock;
+}
+
+IDirect3DStateBlock9* m_IDirect3DDeviceX::FindCachedUIStateBlock(const UISTATESNAPSHOT& State, ULONGLONG Hash)
+{
+	// Drop the cache when the d3d9 device changed or any surface released its d3d9 textures
+	if (ToWorld.UIStateBlockCacheEntries &&
+		(ToWorld.UIStateBlockCacheDevice != *d3d9Device || ToWorld.UIStateBlockCacheGeneration != TPWTextureGeneration))
+	{
+		ClearUIStateBlockCache();
+	}
+
+	auto it = ToWorld.UIStateBlockCache.find(Hash);
+	if (it != ToWorld.UIStateBlockCache.end())
+	{
+		for (UISTATEBLOCKCACHEENTRY& Entry : it->second)
+		{
+			if (IsSameUIState(State, Entry.State))
+			{
+				Entry.StateBlock->AddRef();
+				return Entry.StateBlock;
+			}
+		}
+	}
+	return nullptr;
+}
+
+void m_IDirect3DDeviceX::AddCachedUIStateBlock(const UISTATESNAPSHOT& State, ULONGLONG Hash, IDirect3DStateBlock9* pStateBlock)
+{
+	// Keep the cache bounded, the game normally uses a few hundred UI states
+	const size_t MaxEntries = 2048;
+	if (ToWorld.UIStateBlockCacheEntries >= MaxEntries)
+	{
+		ClearUIStateBlockCache();
+	}
+
+	if (!ToWorld.UIStateBlockCacheEntries)
+	{
+		ToWorld.UIStateBlockCacheDevice = *d3d9Device;
+		ToWorld.UIStateBlockCacheGeneration = TPWTextureGeneration;
+	}
+
+	UISTATEBLOCKCACHEENTRY Entry;
+	Entry.State = State;
+	Entry.StateBlock = pStateBlock;
+	pStateBlock->AddRef();
+	ToWorld.UIStateBlockCache[Hash].push_back(Entry);
+	ToWorld.UIStateBlockCacheEntries++;
+	UIStateBlockCacheOwner = this;
+}
+
+void m_IDirect3DDeviceX::ClearUIStateBlockCache()
+{
+	if (ToWorld.UIStateBlockCacheEntries)
+	{
+		ToWorld.StateBlockCacheClears++;
+	}
+	for (auto& Bucket : ToWorld.UIStateBlockCache)
+	{
+		for (UISTATEBLOCKCACHEENTRY& Entry : Bucket.second)
+		{
+			if (Entry.StateBlock)
+			{
+				Entry.StateBlock->Release();
+			}
+		}
+	}
+	ToWorld.UIStateBlockCache.clear();
+	ToWorld.UIStateBlockCacheEntries = 0;
+	ToWorld.UIStateBlockCacheDevice = nullptr;
+	if (UIStateBlockCacheOwner == this)
+	{
+		UIStateBlockCacheOwner = nullptr;
+	}
+}
+
+void m_IDirect3DDeviceX::ReleaseUIStateBlockCaches()
+{
+	// Queued draws hold state blocks too, they would be dropped at the next scene anyway
+	if (UIQueueOwner)
+	{
+		UIQueueOwner->ClearUIQueue();
+	}
+	if (UIStateBlockCacheOwner)
+	{
+		UIStateBlockCacheOwner->ClearUIStateBlockCache();
+	}
+}
+
+void m_IDirect3DDeviceX::TPWRecordDrawDiag(const char* Func, D3DPRIMITIVETYPE PrimitiveType, DWORD VertexTypeDesc, LPVOID lpVertices, DWORD VertexCount, DWORD IndexCount)
+{
+	if (!Config.DdrawConvertHomogeneousDiagnostics)
+	{
+		return;
+	}
+	TPWDrawDiagByType[(DWORD)PrimitiveType < 8 ? (DWORD)PrimitiveType : 0]++;
+
+	// Lines, points and additive blending (destination blend one), the usual ways to draw lightning and flashes
+	const DWORD AlphaBlend = DeviceStates.RenderState[D3DRENDERSTATE_ALPHABLENDENABLE].State;
+	const DWORD SrcBlend = DeviceStates.RenderState[D3DRENDERSTATE_SRCBLEND].State;
+	const DWORD DestBlend = DeviceStates.RenderState[D3DRENDERSTATE_DESTBLEND].State;
+	const bool IsLineOrPoint = (PrimitiveType == D3DPT_POINTLIST || PrimitiveType == D3DPT_LINELIST || PrimitiveType == D3DPT_LINESTRIP);
+	const bool IsAdditive = AlphaBlend && DestBlend == D3DBLEND_ONE;
+	if (!IsLineOrPoint && !IsAdditive)
+	{
+		return;
+	}
+
+	TPWDRAWDIAGKEY Key = { Func, (DWORD)PrimitiveType, VertexTypeDesc, AlphaBlend, SrcBlend, DestBlend,
+		DeviceStates.RenderState[D3DRENDERSTATE_ZWRITEENABLE].State, (void*)CurrentTextureSurfaceX[0] };
+	TPWDRAWDIAGSTATS& Stats = TPWDrawDiag[Key];
+	Stats.Draws++;
+	Stats.Vertices += VertexCount;
+
+	// Save each texture once so the draw groups can be matched to the game's image files
+	if (CurrentTextureSurfaceX[0] && TPWDrawDiagDumped.size() < 100 && TPWDrawDiagDumped.insert((void*)CurrentTextureSurfaceX[0]).second)
+	{
+		char Path[MAX_PATH] = {};
+		GetModuleFileNameA(nullptr, Path, MAX_PATH);
+		char* Slash = strrchr(Path, '\\');
+		if (Slash)
+		{
+			*(Slash + 1) = '\0';
+			strcat_s(Path, "tpw-texdump");
+			CreateDirectoryA(Path, nullptr);
+			char File[MAX_PATH];
+			sprintf_s(File, "%s\\tex_%p_%u.bmp", Path, (void*)CurrentTextureSurfaceX[0], (UINT)TPWDrawDiagDumped.size());
+			CurrentTextureSurfaceX[0]->TPWDumpTextureToBMP(File);
+		}
+	}
+
+	// Screen bounds of pre-transformed vertices
+	const bool IsRHW = (VertexTypeDesc & D3DFVF_POSITION_MASK) == D3DFVF_XYZRHW;
+	const UINT Stride = GetVertexStride(VertexTypeDesc);
+	if (lpVertices && Stride >= sizeof(float) * 3)
+	{
+		const BYTE* v = (const BYTE*)lpVertices;
+		for (DWORD x = 0; x < VertexCount; x++, v += Stride)
+		{
+			const float* p = (const float*)v;
+			Stats.MinX = min(Stats.MinX, p[0]); Stats.MaxX = max(Stats.MaxX, p[0]);
+			Stats.MinY = min(Stats.MinY, p[1]); Stats.MaxY = max(Stats.MaxY, p[1]);
+			Stats.MinZ = min(Stats.MinZ, p[2]); Stats.MaxZ = max(Stats.MaxZ, p[2]);
+			if (IsRHW)
+			{
+				Stats.MinRHW = min(Stats.MinRHW, p[3]); Stats.MaxRHW = max(Stats.MaxRHW, p[3]);
+			}
+		}
+
+		// A few raw samples of each kind
+		if (Stats.Samples < 2 && TPWDrawDiagSamples < 200)
+		{
+			Stats.Samples++;
+			TPWDrawDiagSamples++;
+			std::string Line;
+			const BYTE* s = (const BYTE*)lpVertices;
+			for (DWORD x = 0; x < VertexCount && x < 4; x++, s += Stride)
+			{
+				const float* p = (const float*)s;
+				char Buf[160];
+				sprintf_s(Buf, " [%.1f %.1f %.4f %.4f", p[0], p[1], p[2], IsRHW ? p[3] : 0.0f);
+				Line += Buf;
+				if (VertexTypeDesc & D3DFVF_DIFFUSE)
+				{
+					const DWORD Diffuse = *(const DWORD*)(s + sizeof(float) * (IsRHW ? 4 : 3) + ((VertexTypeDesc & D3DFVF_NORMAL) ? sizeof(float) * 3 : 0));
+					sprintf_s(Buf, " c=%08X", Diffuse);
+					Line += Buf;
+				}
+				Line += "]";
+			}
+			Logging::Log() << __FUNCTION__ << " TPW draw sample " << Func << " type=" << PrimitiveType << " fvf=" << Logging::hex(VertexTypeDesc) <<
+				" v=" << VertexCount << " i=" << IndexCount << " blend=" << AlphaBlend << " " << SrcBlend << "/" << DestBlend <<
+				" zwrite=" << Key.ZWrite << " tex=" << Key.Texture << " in scene=" << IsInScene << Line.c_str();
+		}
+	}
+}
+
+void m_IDirect3DDeviceX::TPWLogDrawDiag()
+{
+	if (!Config.DdrawConvertHomogeneousDiagnostics)
+	{
+		return;
+	}
+	Logging::Log() << __FUNCTION__ << " TPW draws by type (1 point, 2 line list, 3 line strip, 4 tri list, 5 tri strip, 6 fan):" <<
+		" 1=" << TPWDrawDiagByType[1] << " 2=" << TPWDrawDiagByType[2] << " 3=" << TPWDrawDiagByType[3] <<
+		" 4=" << TPWDrawDiagByType[4] << " 5=" << TPWDrawDiagByType[5] << " 6=" << TPWDrawDiagByType[6] << " unusual kinds=" << TPWDrawDiag.size();
+	std::vector<std::pair<TPWDRAWDIAGKEY, TPWDRAWDIAGSTATS>> Sorted(TPWDrawDiag.begin(), TPWDrawDiag.end());
+	std::sort(Sorted.begin(), Sorted.end(), [](const auto& a, const auto& b) { return a.second.Draws > b.second.Draws; });
+	for (size_t i = 0; i < Sorted.size() && i < 12; i++)
+	{
+		const TPWDRAWDIAGKEY& k = Sorted[i].first;
+		const TPWDRAWDIAGSTATS& s = Sorted[i].second;
+		Logging::Log() << __FUNCTION__ << "   " << k.Func << " type=" << k.PrimitiveType << " fvf=" << Logging::hex(k.VertexTypeDesc) <<
+			" blend=" << k.AlphaBlend << " " << k.SrcBlend << "/" << k.DestBlend << " zwrite=" << k.ZWrite << " tex=" << k.Texture <<
+			" draws=" << s.Draws << " verts=" << s.Vertices << " x[" << s.MinX << "," << s.MaxX << "] y[" << s.MinY << "," << s.MaxY <<
+			"] z[" << s.MinZ << "," << s.MaxZ << "] rhw[" << s.MinRHW << "," << s.MaxRHW << "]";
+	}
+	TPWDrawDiag.clear();
+	ZeroMemory(TPWDrawDiagByType, sizeof(TPWDrawDiagByType));
+}
+
+void m_IDirect3DDeviceX::OnSurfaceTextureReleased()
+{
+	// A surface is about to release its d3d9 textures. Queued and cached UI state blocks may hold them,
+	// and applying such a block later would bind a texture whose wrapper no longer exists. Draw the
+	// queued UI while its textures are still valid, then drop every cached state block.
+	ScopedCriticalSection ThreadLockDD(DdrawWrapper::GetDDCriticalSection());
+
+	if (UIQueueOwner && !UIQueueOwner->ToWorld.UIQueue.empty())
+	{
+		if (UIQueueOwner->IsInScene)
+		{
+			UIQueueOwner->ReplayUIDraws();
+		}
+		else
+		{
+			UIQueueOwner->ClearUIQueue();
+		}
+	}
+	if (UIStateBlockCacheOwner)
+	{
+		UIStateBlockCacheOwner->ClearUIStateBlockCache();
+	}
+}
+
+bool m_IDirect3DDeviceX::QueueUIDraw(D3DPRIMITIVETYPE PrimitiveType, UINT PrimitiveCount, LPVOID lpVertices, UINT VertexCount, UINT Stride, DWORD VertexTypeDesc, DWORD Flags, LPWORD lpwIndices, UINT IndexCount)
+{
+	// Draws with the same game state as the previous queued UI draw share its state block
+	UISTATESNAPSHOT CurrentState;
+	CaptureUIState(CurrentState, VertexTypeDesc, Flags);
+	const bool SameState = !ToWorld.UIQueue.empty() && ToWorld.LastUIStateValid && IsSameUIState(CurrentState, ToWorld.LastUIState);
+
+	if (SameState)
+	{
+		// Merge consecutive triangle lists into one indexed draw
+		QUEUEDUIDRAW& Last = ToWorld.UIQueue.back();
+		if (PrimitiveType == D3DPT_TRIANGLELIST && Last.PrimitiveType == D3DPT_TRIANGLELIST && Last.Stride == Stride &&
+			Last.VertexCount + VertexCount <= 0xFFFF)
+		{
+			if (Last.Indices.empty())
+			{
+				for (UINT i = 0; i < Last.VertexCount; i++)
+				{
+					Last.Indices.push_back((WORD)i);
+				}
+			}
+
+			const WORD Base = (WORD)Last.VertexCount;
+			if (lpwIndices)
+			{
+				for (UINT i = 0; i < IndexCount; i++)
+				{
+					Last.Indices.push_back((WORD)(lpwIndices[i] + Base));
+				}
+			}
+			else
+			{
+				for (UINT i = 0; i < VertexCount; i++)
+				{
+					Last.Indices.push_back((WORD)(i + Base));
+				}
+			}
+
+			Last.Vertices.insert(Last.Vertices.end(), (const BYTE*)lpVertices, (const BYTE*)lpVertices + VertexCount * Stride);
+			Last.VertexCount += VertexCount;
+			Last.PrimitiveCount = (UINT)Last.Indices.size() / 3;
+			Last.SourceDraws++;
+
+			ToWorld.UIQueued++;
+			ToWorld.UIDrawsMerged++;
+			return true;
+		}
+	}
+
+	// Capture the complete device state of this draw (textures, render, texture stage and sampler states, FVF and transforms)
+	IDirect3DStateBlock9* pStateBlock = nullptr;
+	if (SameState)
+	{
+		pStateBlock = ToWorld.UIQueue.back().StateBlock;
+		pStateBlock->AddRef();
+	}
+	else
+	{
+		// Reuse the state block of an identical UI state from an earlier scene
+		const LONGLONG CreateStart = QpcNow();
+		const ULONGLONG Hash = HashUIState(CurrentState);
+		pStateBlock = FindCachedUIStateBlock(CurrentState, Hash);
+		if (pStateBlock)
+		{
+			ToWorld.StateBlocksReused++;
+		}
+		else
+		{
+			if (Config.DdrawConvertHomogeneousLeanUIStateBlocks)
+			{
+				pStateBlock = CreateLeanUIStateBlock();
+			}
+			const HRESULT hrCreate = pStateBlock ? D3D_OK : (*d3d9Device)->CreateStateBlock(D3DSBT_ALL, &pStateBlock);
+			if (FAILED(hrCreate) || !pStateBlock)
+			{
+				ToWorld.TimeCreateStateBlock += QpcNow() - CreateStart;
+				ToWorld.UIReplayFailed++;
+				return false;
+			}
+			ToWorld.StateBlocksCreated++;
+			AddCachedUIStateBlock(CurrentState, Hash, pStateBlock);
+		}
+		ToWorld.TimeCreateStateBlock += QpcNow() - CreateStart;
+		ToWorld.LastUIState = CurrentState;
+		ToWorld.LastUIStateValid = true;
+	}
+
+	QUEUEDUIDRAW Draw;
+	Draw.StateBlock = pStateBlock;
+	Draw.Vertices.assign((const BYTE*)lpVertices, (const BYTE*)lpVertices + VertexCount * Stride);
+	if (lpwIndices)
+	{
+		Draw.Indices.assign(lpwIndices, lpwIndices + IndexCount);
+	}
+	Draw.PrimitiveType = PrimitiveType;
+	Draw.PrimitiveCount = PrimitiveCount;
+	Draw.VertexCount = VertexCount;
+	Draw.Stride = Stride;
+
+	ToWorld.UIQueue.push_back(std::move(Draw));
+	ToWorld.UIQueued++;
+
+	// Remember the textures used, so the queue can be flushed before the game overwrites one of them
+	for (m_IDirectDrawSurfaceX* pTexture : CurrentTextureSurfaceX)
+	{
+		if (pTexture && std::find(ToWorld.UIQueueTextures.begin(), ToWorld.UIQueueTextures.end(), pTexture) == ToWorld.UIQueueTextures.end())
+		{
+			ToWorld.UIQueueTextures.push_back(pTexture);
+		}
+	}
+	UIQueueOwner = this;
+	ToWorld.QueueThreadId = GetCurrentThreadId();
+
+	return true;
+}
+
+m_IDirect3DDeviceX* m_IDirect3DDeviceX::UIQueueOwner = nullptr;
+
+void m_IDirect3DDeviceX::FlushUIQueueBeforeTextureWrite(m_IDirectDrawSurfaceX* pSurface)
+{
+	if (!UIQueueOwner || !pSurface)
+	{
+		return;
+	}
+
+	// The game writes textures from a second thread, and this is called before the surface takes any lock,
+	// so serialize with draws, queueing and replay, which all run under the DirectDraw critical section
+	ScopedCriticalSection ThreadLockDD(DdrawWrapper::GetDDCriticalSection());
+
+	m_IDirect3DDeviceX* pDevice = UIQueueOwner;
+	if (!pDevice || pDevice->ToWorld.UIQueue.empty())
+	{
+		return;
+	}
+
+	const auto& Textures = pDevice->ToWorld.UIQueueTextures;
+	if (std::find(Textures.begin(), Textures.end(), pSurface) == Textures.end())
+	{
+		return;
+	}
+
+	// Queued draws can only be submitted inside a scene
+	if (!pDevice->IsInScene)
+	{
+		pDevice->ToWorld.FlushesSkipped++;
+		return;
+	}
+
+	// Draw the queued UI while the texture still holds the content it was queued with
+	pDevice->ToWorld.TextureFlushes++;
+	if (GetCurrentThreadId() != pDevice->ToWorld.QueueThreadId)
+	{
+		pDevice->ToWorld.TextureFlushesOtherThread++;
+	}
+	pDevice->ToWorld.SceneFlushWorldMarks.push_back(pDevice->ToWorld.WorldDraws);
+	pDevice->ReplayUIDraws();
+}
+
+void m_IDirect3DDeviceX::ReplayUIDraws()
+{
+	if (ToWorld.UIQueue.empty())
+	{
+		return;
+	}
+
+	const LONGLONG ReplayStart = QpcNow();
+
+	// All world draws counted so far were submitted before this replay
+	ToWorld.WorldDrawsBeforeReplay = ToWorld.WorldDraws;
+
+	// Save the current device state so it can be restored after the replay
+	IDirect3DStateBlock9* pRestoreBlock = nullptr;
+	LONGLONG TimerStart = QpcNow();
+	if (FAILED((*d3d9Device)->CreateStateBlock(D3DSBT_ALL, &pRestoreBlock)))
+	{
+		pRestoreBlock = nullptr;
+		LOG_LIMIT(10, __FUNCTION__ << " Warning: could not save device state before UI replay!");
+	}
+	ToWorld.TimeRestoreBlock += QpcNow() - TimerStart;
+
+	// RTX Remix detects UI from the first orthographic draw without z writes and rasterizes everything after it.
+	// Trigger that with one off-screen triangle, so the queued UI keeps the game's own z states and draw order.
+	{
+		const QUEUEDUIDRAW& First = ToWorld.UIQueue.front();
+		TimerStart = QpcNow();
+		const bool FirstApplied = First.Stride >= sizeof(float) * 3 && SUCCEEDED(First.StateBlock->Apply());
+		ToWorld.TimeApplyStateBlock += QpcNow() - TimerStart;
+		ToWorld.ApplyCount++;
+		if (FirstApplied)
+		{
+			TimerStart = QpcNow();
+			std::vector<BYTE> Triangle(First.Stride * 3, 0);
+			const float Positions[3][3] = { { -100.0f, -100.0f, 0.0f }, { -90.0f, -100.0f, 0.0f }, { -100.0f, -90.0f, 0.0f } };
+			for (UINT i = 0; i < 3; i++)
+			{
+				memcpy(Triangle.data() + i * First.Stride, Positions[i], sizeof(Positions[i]));
+			}
+			(*d3d9Device)->SetRenderState(D3DRS_ZWRITEENABLE, FALSE);
+			if (SUCCEEDED((*d3d9Device)->DrawPrimitiveUP(D3DPT_TRIANGLELIST, 1, Triangle.data(), First.Stride)))
+			{
+				ToWorld.UITriggerDraws++;
+			}
+			ToWorld.TimeUIDraws += QpcNow() - TimerStart;
+		}
+	}
+
+	IDirect3DStateBlock9* pAppliedBlock = nullptr;	// The first entry is applied again below to restore its z states
+	for (QUEUEDUIDRAW& Draw : ToWorld.UIQueue)
+	{
+		// Consecutive entries that share a state block only need it applied once
+		HRESULT hr = D3D_OK;
+		if (Draw.StateBlock != pAppliedBlock)
+		{
+			TimerStart = QpcNow();
+			hr = Draw.StateBlock->Apply();
+			ToWorld.TimeApplyStateBlock += QpcNow() - TimerStart;
+			ToWorld.ApplyCount++;
+			pAppliedBlock = SUCCEEDED(hr) ? Draw.StateBlock : nullptr;
+		}
+		if (SUCCEEDED(hr))
+		{
+			TimerStart = QpcNow();
+			hr = Draw.Indices.empty() ?
+				(*d3d9Device)->DrawPrimitiveUP(Draw.PrimitiveType, Draw.PrimitiveCount, Draw.Vertices.data(), Draw.Stride) :
+				(*d3d9Device)->DrawIndexedPrimitiveUP(Draw.PrimitiveType, 0, Draw.VertexCount, Draw.PrimitiveCount, Draw.Indices.data(), D3DFMT_INDEX16, Draw.Vertices.data(), Draw.Stride);
+			ToWorld.TimeUIDraws += QpcNow() - TimerStart;
+			ToWorld.UIReplayDrawCalls++;
+		}
+
+		if (SUCCEEDED(hr))
+		{
+			ToWorld.UIReplayed += Draw.SourceDraws;
+		}
+		else
+		{
+			ToWorld.UIReplayFailed += Draw.SourceDraws;
+			LOG_LIMIT(10, __FUNCTION__ << " Error: UI replay failed: " << (D3DERR)hr);
+		}
+	}
+
+	if (pRestoreBlock)
+	{
+		TimerStart = QpcNow();
+		pRestoreBlock->Apply();
+		pRestoreBlock->Release();
+		ToWorld.TimeRestoreBlock += QpcNow() - TimerStart;
+	}
+
+	ClearUIQueue();
+	ToWorld.TimeReplay += QpcNow() - ReplayStart;
+}
+
+void m_IDirect3DDeviceX::ClearUIQueue()
+{
+	for (QUEUEDUIDRAW& Draw : ToWorld.UIQueue)
+	{
+		if (Draw.StateBlock)
+		{
+			Draw.StateBlock->Release();
+		}
+	}
+	ToWorld.UIQueue.clear();
+	ToWorld.UIQueueTextures.clear();
+	ToWorld.LastUIStateValid = false;
+	if (UIQueueOwner == this)
+	{
+		UIQueueOwner = nullptr;
+	}
+}
