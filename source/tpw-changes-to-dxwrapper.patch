+// TPW: record which game code asks the process to quit (game IAT hooks for ExitProcess, TerminateProcess,
+// PostQuitMessage and DestroyWindow). Each call logs the game return addresses found on the stack.
+namespace
+{
+	typedef VOID(WINAPI* ExitProcessProc)(UINT);
+	typedef BOOL(WINAPI* TerminateProcessProc)(HANDLE, UINT);
+	typedef VOID(WINAPI* PostQuitMessageProc)(int);
+	typedef BOOL(WINAPI* DestroyWindowProc)(HWND);
+	ExitProcessProc TPWExitProcess_out = nullptr;
+	TerminateProcessProc TPWTerminateProcess_out = nullptr;
+	PostQuitMessageProc TPWPostQuitMessage_out = nullptr;
+	DestroyWindowProc TPWDestroyWindow_out = nullptr;
+
+	void TPWLogQuitCaller(const char* Func, void* Caller, DWORD Value)
+	{
+		const BYTE* Base = (const BYTE*)GetModuleHandleA(nullptr);
+		const IMAGE_NT_HEADERS* Nt = (const IMAGE_NT_HEADERS*)(Base + ((const IMAGE_DOS_HEADER*)Base)->e_lfanew);
+		const BYTE* End = Base + Nt->OptionalHeader.SizeOfImage;
+		std::string Trace;
+		char Buf[32];
+		DWORD Found = 0;
+		const DWORD* Stack = (const DWORD*)&Caller;
+		NT_TIB* Tib = (NT_TIB*)NtCurrentTeb();
+		for (DWORD x = 0; x < 2048 && Found < 16 && (const BYTE*)(Stack + x + 1) <= (const BYTE*)Tib->StackBase; x++)
+		{
+			const BYTE* v = (const BYTE*)Stack[x];
+			if (v > Base + Nt->OptionalHeader.BaseOfCode && v < End)
+			{
+				sprintf_s(Buf, " exe+0x%X", (DWORD)(v - Base));
+				Trace += Buf;
+				Found++;
+			}
+		}
+		sprintf_s(Buf, "exe+0x%X", (DWORD)((const BYTE*)Caller - Base));
+		Logging::Log() << "TPW: game called " << Func << "(" << Value << ") from " << Buf << " thread " << GetCurrentThreadId() <<
+			", game addresses on stack:" << Trace.c_str();
+	}
+
+	VOID WINAPI TPWExitProcess(UINT uExitCode)
+	{
+		TPWLogQuitCaller("ExitProcess", _ReturnAddress(), uExitCode);
+		TPWExitProcess_out(uExitCode);
+	}
+
+	BOOL WINAPI TPWTerminateProcess(HANDLE hProcess, UINT uExitCode)
+	{
+		TPWLogQuitCaller("TerminateProcess", _ReturnAddress(), uExitCode);
+		return TPWTerminateProcess_out(hProcess, uExitCode);
+	}
+
+	VOID WINAPI TPWPostQuitMessage(int nExitCode)
+	{
+		TPWLogQuitCaller("PostQuitMessage", _ReturnAddress(), (DWORD)nExitCode);
+		TPWPostQuitMessage_out(nExitCode);
+	}
+
+	BOOL WINAPI TPWDestroyWindow(HWND hWnd)
+	{
+		TPWLogQuitCaller("DestroyWindow", _ReturnAddress(), (DWORD)(ULONG_PTR)hWnd);
+		return TPWDestroyWindow_out(hWnd);
+	}
+
+	// Replaces one import of the game exe, returns the original function
+	void* TPWPatchGameImport(const char* DllName, const char* FuncName, void* NewFunc)
+	{
+		BYTE* Base = (BYTE*)GetModuleHandleA(nullptr);
+		IMAGE_NT_HEADERS* Nt = (IMAGE_NT_HEADERS*)(Base + ((IMAGE_DOS_HEADER*)Base)->e_lfanew);
+		const IMAGE_DATA_DIRECTORY& Dir = Nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+		if (!Dir.VirtualAddress)
+		{
+			return nullptr;
+		}
+		for (IMAGE_IMPORT_DESCRIPTOR* Desc = (IMAGE_IMPORT_DESCRIPTOR*)(Base + Dir.VirtualAddress); Desc->Name; Desc++)
+		{
+			if (_stricmp((const char*)(Base + Desc->Name), DllName) != 0 || !Desc->OriginalFirstThunk)
+			{
+				continue;
+			}
+			IMAGE_THUNK_DATA* Names = (IMAGE_THUNK_DATA*)(Base + Desc->OriginalFirstThunk);
+			IMAGE_THUNK_DATA* Funcs = (IMAGE_THUNK_DATA*)(Base + Desc->FirstThunk);
+			for (; Names->u1.AddressOfData; Names++, Funcs++)
+			{
+				if (IMAGE_SNAP_BY_ORDINAL(Names->u1.Ordinal))
+				{
+					continue;
+				}
+				const IMAGE_IMPORT_BY_NAME* Import = (const IMAGE_IMPORT_BY_NAME*)(Base + Names->u1.AddressOfData);
+				if (strcmp((const char*)Import->Name, FuncName) == 0)
+				{
+					void* Original = (void*)Funcs->u1.Function;
+					DWORD OldProtect = 0;
+					if (VirtualProtect(&Funcs->u1.Function, sizeof(Funcs->u1.Function), PAGE_READWRITE, &OldProtect))
+					{
+						Funcs->u1.Function = (ULONG_PTR)NewFunc;
+						VirtualProtect(&Funcs->u1.Function, sizeof(Funcs->u1.Function), OldProtect, &OldProtect);
+						return Original;
+					}
+					return nullptr;
+				}
+			}
+		}
+		return nullptr;
+	}
+
+	void TPWInstallQuitHooks()
+	{
+		TPWExitProcess_out = (ExitProcessProc)TPWPatchGameImport("kernel32.dll", "ExitProcess", TPWExitProcess);
+		TPWTerminateProcess_out = (TerminateProcessProc)TPWPatchGameImport("kernel32.dll", "TerminateProcess", TPWTerminateProcess);
+		TPWPostQuitMessage_out = (PostQuitMessageProc)TPWPatchGameImport("user32.dll", "PostQuitMessage", TPWPostQuitMessage);
+		TPWDestroyWindow_out = (DestroyWindowProc)TPWPatchGameImport("user32.dll", "DestroyWindow", TPWDestroyWindow);
+		Logging::Log() << "TPW: quit hooks installed: ExitProcess " << (TPWExitProcess_out != nullptr) << " TerminateProcess " << (TPWTerminateProcess_out != nullptr) <<
+			" PostQuitMessage " << (TPWPostQuitMessage_out != nullptr) << " DestroyWindow " << (TPWDestroyWindow_out != nullptr);
+	}
+}
