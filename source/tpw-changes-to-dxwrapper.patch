+// Diagnostics: saves mip level 0 of this texture as a 32-bit BMP with alpha, so a draw can be matched to the game's image files
+bool m_IDirectDrawSurfaceX::TPWDumpTextureToBMP(const char* FileName)
+{
+	if (!surface.Surface && !surface.Texture)
+	{
+		return false;
+	}
+
+	D3DSURFACE_DESC Desc = {};
+	if (FAILED(surface.Surface ? surface.Surface->GetDesc(&Desc) : surface.Texture->GetLevelDesc(GetD9MipMapLevel(0), &Desc)) ||
+		!Desc.Width || !Desc.Height || Desc.Width > 4096 || Desc.Height > 4096)
+	{
+		return false;
+	}
+
+	const D3DFORMAT Format = Desc.Format;
+	if (Format != D3DFMT_A8R8G8B8 && Format != D3DFMT_X8R8G8B8 && Format != D3DFMT_R5G6B5 &&
+		Format != D3DFMT_A1R5G5B5 && Format != D3DFMT_X1R5G5B5 && Format != D3DFMT_A4R4G4B4)
+	{
+		Logging::Log() << __FUNCTION__ << " TPW texture dump skipped, unsupported format " << Format;
+		return false;
+	}
+
+	D3DLOCKED_RECT LockRect = {};
+	if (FAILED(LockD3d9Surface(&LockRect, nullptr, D3DLOCK_READONLY, 0)) || !LockRect.pBits)
+	{
+		Logging::Log() << __FUNCTION__ << " TPW texture dump failed to lock";
+		return false;
+	}
+
+	std::vector<DWORD> Pixels(Desc.Width * Desc.Height);
+	for (UINT y = 0; y < Desc.Height; y++)
+	{
+		const BYTE* Row = (const BYTE*)LockRect.pBits + y * LockRect.Pitch;
+		DWORD* Out = &Pixels[(Desc.Height - 1 - y) * Desc.Width];	// BMP rows go bottom up
+		for (UINT x = 0; x < Desc.Width; x++)
+		{
+			DWORD c = 0;
+			switch (Format)
+			{
+			case D3DFMT_A8R8G8B8: c = ((const DWORD*)Row)[x]; break;
+			case D3DFMT_X8R8G8B8: c = ((const DWORD*)Row)[x] | 0xFF000000; break;
+			case D3DFMT_R5G6B5:
+			{
+				const WORD w = ((const WORD*)Row)[x];
+				c = 0xFF000000 | ((((w >> 11) & 0x1F) * 255 / 31) << 16) | ((((w >> 5) & 0x3F) * 255 / 63) << 8) | ((w & 0x1F) * 255 / 31);
+				break;
+			}
+			case D3DFMT_A1R5G5B5:
+			case D3DFMT_X1R5G5B5:
+			{
+				const WORD w = ((const WORD*)Row)[x];
+				const DWORD a = (Format == D3DFMT_X1R5G5B5 || (w & 0x8000)) ? 0xFF000000 : 0;
+				c = a | ((((w >> 10) & 0x1F) * 255 / 31) << 16) | ((((w >> 5) & 0x1F) * 255 / 31) << 8) | ((w & 0x1F) * 255 / 31);
+				break;
+			}
+			case D3DFMT_A4R4G4B4:
+			{
+				const WORD w = ((const WORD*)Row)[x];
+				c = (((w >> 12) & 0xF) * 17 << 24) | (((w >> 8) & 0xF) * 17 << 16) | (((w >> 4) & 0xF) * 17 << 8) | ((w & 0xF) * 17);
+				break;
+			}
+			default: break;
+			}
+			Out[x] = c;
+		}
+	}
+	UnLockD3d9Surface(0);
+
+	BITMAPINFOHEADER bi = {};
+	bi.biSize = sizeof(BITMAPINFOHEADER);
+	bi.biWidth = Desc.Width;
+	bi.biHeight = Desc.Height;
+	bi.biPlanes = 1;
+	bi.biBitCount = 32;
+	bi.biCompression = BI_RGB;
+	BITMAPFILEHEADER bmf = {};
+	bmf.bfType = 0x4D42; // "BM"
+	bmf.bfOffBits = sizeof(BITMAPFILEHEADER) + sizeof(BITMAPINFOHEADER);
+	bmf.bfSize = bmf.bfOffBits + (DWORD)(Pixels.size() * sizeof(DWORD));
+
+	std::ofstream OutFile(FileName, std::ios::binary | std::ios::out);
+	if (!OutFile.is_open())
+	{
+		return false;
+	}
+	OutFile.write((const char*)&bmf, sizeof(bmf));
+	OutFile.write((const char*)&bi, sizeof(bi));
+	OutFile.write((const char*)Pixels.data(), Pixels.size() * sizeof(DWORD));
+	OutFile.close();
+
+	Logging::Log() << __FUNCTION__ << " TPW texture dump " << this << " " << Desc.Width << "x" << Desc.Height << " format " << Format << " -> " << FileName;
+	return true;
+}
