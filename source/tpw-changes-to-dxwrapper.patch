+// TPW: hang watchdog. When no frame has been presented for 3 seconds it suspends the presenting thread for a moment,
+// copies its instruction pointer and the game return addresses on its stack, resumes it and only then logs them
+// (no allocation or logging while the thread is suspended, it may hold the heap or log lock).
+namespace
+{
+	volatile LONG TPWWatchdogLastPresent = 0;
+	volatile DWORD TPWWatchdogThreadId = 0;
+	HANDLE TPWWatchdogThread = nullptr;
+
+	void TPWDescribeAddress(DWORD Address, char* Out, size_t OutSize)
+	{
+		HMODULE Module = nullptr;
+		char Name[MAX_PATH] = {};
+		if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, (LPCSTR)(ULONG_PTR)Address, &Module) &&
+			GetModuleFileNameA(Module, Name, MAX_PATH))
+		{
+			const char* Slash = strrchr(Name, '\\');
+			sprintf_s(Out, OutSize, "%s+0x%X", Slash ? Slash + 1 : Name, Address - (DWORD)(ULONG_PTR)Module);
+		}
+		else
+		{
+			sprintf_s(Out, OutSize, "0x%X", Address);
+		}
+	}
+
+	DWORD WINAPI TPWWatchdogProc(LPVOID)
+	{
+		const BYTE* Base = (const BYTE*)GetModuleHandleA(nullptr);
+		const IMAGE_NT_HEADERS* Nt = (const IMAGE_NT_HEADERS*)(Base + ((const IMAGE_DOS_HEADER*)Base)->e_lfanew);
+		const DWORD CodeStart = (DWORD)(ULONG_PTR)(Base + Nt->OptionalHeader.BaseOfCode);
+		const DWORD CodeEnd = (DWORD)(ULONG_PTR)(Base + Nt->OptionalHeader.SizeOfImage);
+		DWORD Samples = 0;
+		DWORD Freezes = 0;
+		bool Frozen = false;
+		while (!Config.Exiting)
+		{
+			Sleep(500);
+			const DWORD Idle = GetTickCount() - (DWORD)TPWWatchdogLastPresent;
+			if (Idle < 3000)
+			{
+				if (Frozen)
+				{
+					Logging::Log() << "TPW watchdog: frames resumed after the freeze";
+					Frozen = false;
+				}
+				Samples = 0;
+				continue;
+			}
+			if (!Frozen)
+			{
+				Frozen = true;
+				Freezes++;
+			}
+			// Sample every 2 seconds, at most 12 times per freeze and 5 freezes per run
+			if (Samples >= 12 || Freezes > 5 || (Samples && Idle < 3000 + Samples * 2000))
+			{
+				continue;
+			}
+			Samples++;
+
+			HANDLE hThread = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, TPWWatchdogThreadId);
+			if (!hThread)
+			{
+				continue;
+			}
+			CONTEXT Context = {};
+			Context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+			DWORD Stack[24] = {};
+			DWORD Found = 0;
+			bool Got = false;
+			if (SuspendThread(hThread) != (DWORD)-1)
+			{
+				if (GetThreadContext(hThread, &Context))
+				{
+					Got = true;
+					const DWORD* Sp = (const DWORD*)(ULONG_PTR)Context.Esp;
+					MEMORY_BASIC_INFORMATION mbi = {};
+					if (VirtualQuery(Sp, &mbi, sizeof(mbi)))
+					{
+						const DWORD* Top = (const DWORD*)((const BYTE*)mbi.BaseAddress + mbi.RegionSize);
+						for (const DWORD* s = Sp; s < Top && s < Sp + 4096 && Found < 24; s++)
+						{
+							if (*s >= CodeStart && *s < CodeEnd)
+							{
+								Stack[Found++] = *s;
+							}
+						}
+					}
+				}
+				ResumeThread(hThread);
+			}
+			CloseHandle(hThread);
+			if (!Got)
+			{
+				continue;
+			}
+
+			char Where[MAX_PATH + 32];
+			TPWDescribeAddress(Context.Eip, Where, sizeof(Where));
+			std::string Trace;
+			char Buf[32];
+			for (DWORD x = 0; x < Found; x++)
+			{
+				sprintf_s(Buf, " exe+0x%X", Stack[x] - (DWORD)(ULONG_PTR)Base);
+				Trace += Buf;
+			}
+			Logging::Log() << "TPW watchdog: no frame for " << Idle << " ms, thread " << TPWWatchdogThreadId << " at " << Where <<
+				" eax=" << Logging::hex(Context.Eax) << " ecx=" << Logging::hex(Context.Ecx) << " esi=" << Logging::hex(Context.Esi) <<
+				", game addresses on stack:" << Trace.c_str();
+		}
+		return 0;
+	}
+
+	void TPWWatchdogPresent()
+	{
+		InterlockedExchange(&TPWWatchdogLastPresent, (LONG)GetTickCount());
+		TPWWatchdogThreadId = GetCurrentThreadId();
+		if (!TPWWatchdogThread)
+		{
+			TPWWatchdogThread = CreateThread(nullptr, 0, TPWWatchdogProc, nullptr, 0, nullptr);
+			Logging::Log() << "TPW watchdog started";
+		}
+	}
+}
