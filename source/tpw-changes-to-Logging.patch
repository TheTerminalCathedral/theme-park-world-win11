-	typedef LogNull LogDebug;
+	// TPW stall trace: release builds count the functions named by LogDebug while rendering has stopped
+	namespace StallTrace
+	{
+		extern volatile bool Enabled;
+		void Record(const char* Name);
+	}
+
+	class LogDebugTrace
+	{
+		bool First = true;
+	public:
+		LogDebugTrace& operator<<(const char* Name)
+		{
+			if (First)
+			{
+				First = false;
+				if (StallTrace::Enabled)
+				{
+					StallTrace::Record(Name);
+				}
+			}
+			return *this;
+		}
+		template <size_t N> LogDebugTrace& operator<<(const char(&Name)[N]) { return *this << static_cast<const char*>(Name); }
+		template <typename T> LogDebugTrace& operator<<(const T&) { First = false; return *this; }
+	};
+
+	typedef LogDebugTrace LogDebug;
 
